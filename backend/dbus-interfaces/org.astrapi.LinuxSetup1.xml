<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
                "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/org/astrapi/LinuxSetup1">
<interface name="org.astrapi.LinuxSetup1">
    <method name="Version">
        <arg direction="out" name="version" type="s"/>
    </method>
    <method name="Audit">
        <arg direction="in" name="profile" type="s"/>
        <arg direction="in" name="quick" type="b"/>
        <arg direction="out" name="json" type="s"/>
    </method>
    <method name="Harden">
        <arg direction="in" name="profile" type="s"/>
        <arg direction="out" name="json" type="s"/>
    </method>
    <method name="Fix">
        <arg direction="in" name="fix_id" type="s"/>
        <arg direction="out" name="json" type="s"/>
    </method>
    <method name="GetLatest">
        <arg direction="out" name="json" type="s"/>
    </method>
    <signal name="RunCompleted">
        <arg name="kind" type="s"/>
        <arg name="ts" type="s"/>
    </signal>
</interface>
</node>